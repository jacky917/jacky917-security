<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd"
         child.project.url.inherit.append.path="false">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>3.5.16</version>
        <relativePath/> <!-- lookup parent from repository -->
    </parent>

    <groupId>com.github.jacky917</groupId>
    <artifactId>jacky917-security-parent</artifactId>
    <version>1.1.0</version>
    <packaging>pom</packaging>
    <name>jacky917-security-parent</name>
    <description>Parent POM for jacky917-security projects</description>
    <url>https://github.com/jacky917/jacky917-security</url>

    <!-- 覆寫自 spring-boot-starter-parent 繼承的 Spring 專案資訊（授權條款、開發者、SCM） -->
    <licenses>
        <license>
            <name>MIT License</name>
            <url>https://opensource.org/license/mit</url>
            <distribution>repo</distribution>
        </license>
    </licenses>
    <developers>
        <developer>
            <id>jacky917</id>
            <name>jacky917</name>
            <url>https://github.com/jacky917</url>
        </developer>
    </developers>
    <scm child.scm.url.inherit.append.path="false"
         child.scm.connection.inherit.append.path="false"
         child.scm.developerConnection.inherit.append.path="false">
        <url>https://github.com/jacky917/jacky917-security/tree/1.x</url>
        <connection>scm:git:https://github.com/jacky917/jacky917-security.git</connection>
        <developerConnection>scm:git:git@github.com:jacky917/jacky917-security.git</developerConnection>
        <tag>1.x</tag>
    </scm>

    <properties>
        <java.version>21</java.version>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
        <project.reporting.outputEncoding>UTF-8</project.reporting.outputEncoding>
    </properties>

    <modules>
        <module>jacky917-security-starter</module>
        <module>jacky917-security-autoconfigure</module>
        <module>jacky917-security-annotations</module>
        <module>demo-resource-server</module>
        <module>demo-authorization-server</module>
    </modules>

    <dependencyManagement>
        <dependencies>
            <!-- Project Modules -->
            <dependency>
                <groupId>com.github.jacky917</groupId>
                <artifactId>jacky917-security-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jacky917</groupId>
                <artifactId>jacky917-security-autoconfigure</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>com.github.jacky917</groupId>
                <artifactId>jacky917-security-annotations</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <pluginManagement>
            <plugins>
                <plugin>
                    <groupId>org.apache.maven.plugins</groupId>
                    <artifactId>maven-compiler-plugin</artifactId>
                    <configuration>
                        <source>${java.version}</source>
                        <target>${java.version}</target>
                        <encoding>${project.build.sourceEncoding}</encoding>
                        <!-- JDK 23+ 不再自動探索 annotation processor，需明確宣告（否則 Lombok 不會執行） -->
                        <annotationProcessorPaths>
                            <path>
                                <groupId>org.projectlombok</groupId>
                                <artifactId>lombok</artifactId>
                                <version>${lombok.version}</version>
                            </path>
                            <path>
                                <groupId>org.springframework.boot</groupId>
                                <artifactId>spring-boot-configuration-processor</artifactId>
                                <version>${spring-boot.version}</version>
                            </path>
                        </annotationProcessorPaths>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>
    
    <distributionManagement>
        <repository>
            <id>github</id>
            <name>GitHub Packages</name>
            <url>https://maven.pkg.github.com/jacky917/jacky917-security</url>
        </repository>
    </distributionManagement>
</project>
